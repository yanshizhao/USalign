{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-O0",
                "-ffast-math",
                "-std=gnu++11",
                "-Isrc/common",
                "-Isrc/engine/tmalign",
                "-Isrc/engine/flexalign",
                "-Isrc/engine/mmalign",
                "-Isrc/engine/mmdock",
                "-Isrc/engine/mtmalign",
                "-Isrc/engine/soialign",
                "-Isrc/engine/se",
                "-Isrc/engine/tmscore",
                "-Isrc/engine/hwrmsd",
                "-Isrc/engine/upgma",
                "-Isrc/output_funcs",
                "-Isrc/app/tools",
                "-Isrc/app/tools/tool_include",
                "src/app/usalign/usalign.cpp",
                "src/engine/upgma/UPGMA.cpp",
                "src/engine/tmalign/TMalign.cpp",
                "src/engine/mmalign/MMalign.cpp",
                "src/engine/mmdock/MMdock.cpp",
                "src/engine/mtmalign/mTMalign.cpp",
                "src/engine/flexalign/flexalign.cpp",
                "src/engine/tmscore/TMscore.cpp",
                "src/engine/hwrmsd/HwRMSD.cpp",
                "src/engine/soialign/SOIalign.cpp",
                "src/common/common.cpp",
                "src/common/orchestration.cpp",
                "src/output_funcs/output.cpp",
                "-o", "USalign_dbg.exe",
                "-static",
                "-lm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build se debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-O0",
                "-ffast-math",
                "-std=gnu++11",
                "-Isrc/common",
                "-Isrc/engine/tmalign",
                "-Isrc/engine/flexalign",
                "-Isrc/engine/mmalign",
                "-Isrc/engine/mmdock",
                "-Isrc/engine/mtmalign",
                "-Isrc/engine/soialign",
                "-Isrc/engine/se",
                "-Isrc/engine/tmscore",
                "-Isrc/engine/hwrmsd",
                "-Isrc/engine/upgma",
                "-Isrc/output_funcs",
                "-Isrc/app/tools",
                "-Isrc/app/tools/tool_include",
                "src/app/tools/tool_main/se_main.cpp",
                "src/common/common.cpp",
                "src/common/orchestration.cpp",
                "src/engine/tmalign/TMalign.cpp",
                "src/engine/flexalign/flexalign.cpp",
                "src/engine/tmscore/TMscore.cpp",
                "src/engine/hwrmsd/HwRMSD.cpp",
                "src/engine/soialign/SOIalign.cpp",
                "src/output_funcs/output.cpp",
                "-o", "se_dbg.exe",
                "-static",
                "-lm"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}
