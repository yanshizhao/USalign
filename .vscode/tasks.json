{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-O0",
                "-ffast-math",
                "-std=gnu++11",
                "-Icommon",
                "-Iengine/tmalign",
                "-Iengine/flexalign",
                "-Iengine/mmalign",
                "-Iengine/soialign",
                "-Iengine/se",
                "-Iengine/tmscore",
                "-Iengine/hwrmsd",
                "-Iengine/upgma",
                "-Iorchestration",
                "-Ioutput",
                "-Iapp/tools",
                "app/usalign.cpp",
                "engine/upgma/UPGMA.cpp",
                "common/common.cpp",
                "engine/tmalign/TMalign.cpp",
                "engine/flexalign/flexalign.cpp",
                "engine/tmscore/TMscore.cpp",
                "engine/hwrmsd/HwRMSD.cpp",
                "engine/soialign/SOIalign.cpp",
                "orchestration/orchestration.cpp",
                "output/output.cpp",
                "output/tmalign_output.cpp",
                "-o", "USalign_dbg.exe",
                "-static",
                "-lm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build se debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-O0",
                "-ffast-math",
                "-std=gnu++11",
                "-Icommon",
                "-Iengine/tmalign",
                "-Iengine/flexalign",
                "-Iengine/mmalign",
                "-Iengine/soialign",
                "-Iengine/se",
                "-Iengine/tmscore",
                "-Iengine/hwrmsd",
                "-Iengine/upgma",
                "-Iorchestration",
                "-Ioutput",
                "-Iapp/tools",
                "app/tools/se_main.cpp",
                "common/common.cpp",
                "engine/tmalign/TMalign.cpp",
                "engine/flexalign/flexalign.cpp",
                "engine/tmscore/TMscore.cpp",
                "engine/hwrmsd/HwRMSD.cpp",
                "engine/soialign/SOIalign.cpp",
                "output/output.cpp",
                "output/tmalign_output.cpp",
                "-o", "se_dbg.exe",
                "-static",
                "-lm"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}
